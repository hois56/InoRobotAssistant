  "patterns": [
    {
      "source": "^\\[(.+)\\] 제품 상세 및 구성$",
      "target": "[$1] 产品详情与配置"
    },
    {
      "source": "^Current Ver (.+)$",
      "target": "当前版本 $1"
    },
    {
      "source": "^visits ([0-9,]+)$",
      "target": "访问量 $1"
    },
    {
      "source": "^RemoteIO 파싱 오류: (.+)$",
      "target": "Remote I/O 解析错误：$1"
    },
    {
      "source": "^([0-9]+)주$",
      "target": "$1 周"
    }
  ]
}

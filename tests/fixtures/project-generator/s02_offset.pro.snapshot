ProgramInfo
    Version = "S4.24"
    VRC = "V4R24"
    Time = "<TIMESTAMP>"
    RobotName = "IR-R10-140S5-D1NH-INT_01741041"
EndProgramInfo
Func Set_PR()
    #================================================================================
    #  Offset
    #================================================================================
    Switch B_Cur_process
        #============================================================================
        #  P1 - Tray Get
        #============================================================================
        Case 1:
            PR[B_PR] = (xwOffset_1_X.Int/10000,xwOffset_1_Y.Int/10000,xwOffset_1_Z.Int/10000,xwOffset_1_A.Int/10000,0,0);
            Set_tray_offset();
            Break;
        #============================================================================
        #  P2 - Stage Put
        #============================================================================
        Case 2:
            PR[B_PR] = (xwOffset_2_X.Int/10000,xwOffset_2_Y.Int/10000,xwOffset_2_Z.Int/10000,xwOffset_2_A.Int/10000,0,0);
            Break;
        #============================================================================
        #  P3 - Vision Check
        #============================================================================
        Case 3:
            PR[B_PR] = (xwOffset_3_X.Int/10000,xwOffset_3_Y.Int/10000,xwOffset_3_Z.Int/10000,xwOffset_3_A.Int/10000,0,0);
            Break;
    EndSwitch;
    #================================================================================
    #  Teach mode offset
    #================================================================================
    If xTeach_mode
        PR[5] = (xwTeach_offset_X.Int/10000,xwTeach_offset_Y.Int/10000,xwTeach_offset_Z.Int/10000,xwTeach_offset_A.Int/10000,xwTeach_offset_B.Int/10000,xwTeach_offset_C.Int/10000);
        PR[6] = PR[5] + PR[B_PR];
    EndIf;
EndFunc;
#====================================================================================
#  Set tray offset
#====================================================================================
Func Set_tray_offset()
    #============================================================
    # Setting
    #============================================================
    Int X_count = 3;       # X Cell Count
    Int Y_count = 3;       # Y Cell Count
    Double pitch_X = -58;    # X Pitch
    Double pitch_Y = -58;    # Y Pitch
    #============================================================
    # Cell Number
    #============================================================
    Int num = xwTray_index - 1;
    Int total_cell = X_count * Y_count;
    #============================================================
    # Range Check
    #============================================================
    If num < 0 Or num >= total_cell
        Alarm[12];
        Ret;
    EndIf;
    #============================================================
    # Row / Column Calculate
    #============================================================
    Int row = num / X_count;
    Int col = num - (row * X_count);
    #============================================================
    # Offset Calculate
    #============================================================
    LPR[B_PR] = (pitch_X*row, pitch_Y*col,0,0,0,0);
    PR[B_PR] = PR[B_PR] + LPR[B_PR];
EndFunc;

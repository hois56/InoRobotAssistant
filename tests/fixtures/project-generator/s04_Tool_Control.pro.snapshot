ProgramInfo
    Version = "S4.24"
    VRC = "V4R24"
    Time = "<TIMESTAMP>"
    RobotName = "IR-R10-140S5-D1NH-INT_01741041"
EndProgramInfo
Func Tool_Vac_ON()
    Set yTool_vac_off,OFF;
    Set yTool_vac_on,ON;
    Wait xTool_vac_on_chk == ON, T[60], Goto L[900];
    Set yTool_vac_on,OFF;
    Ret;
    L[900]:
    s01_initial.Init_signal();
    Alarm[0];
EndFunc;
#====================================================================================
Func Tool_Vac_OFF()
    Set yTool_vac_on,OFF;
    Set yTool_vac_off,ON;
    Wait xTool_vac_off_chk == ON, T[60], Goto L[901];
    Set yTool_vac_off,OFF;
    Ret;
    L[901]:
    s01_initial.Init_signal();
    Alarm[1];
EndFunc;
#====================================================================================
Func Tool_Grip()
    Set yTool_ungrip,OFF;

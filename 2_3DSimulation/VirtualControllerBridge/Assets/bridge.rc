1 ICON "Assets/bridge.ico"

101 DIALOGEX 0, 0, 320, 115
// Centered fixed dialog with a caption, system menu and minimize button.
STYLE 0x80CA08C0
EXSTYLE 0x00040000
CAPTION "InoRobot Virtual Controller Bridge"
FONT 9, "Segoe UI", 400, 0, 1
BEGIN
    ICON 1, -1, 15, 13, 25, 25
    LTEXT "", 1001, 52, 13, 250, 11
    LTEXT "", 1002, 52, 28, 250, 11
    LTEXT "", 1003, 15, 50, 290, 30
    DEFPUSHBUTTON "", 1, 245, 89, 60, 18
END

1 VERSIONINFO
 FILEVERSION 2,0,0,0
 PRODUCTVERSION 2,0,0,0
 FILEOS 0x40004
 FILETYPE 1
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "InoRobot 3D Simulation controller bridge"
            VALUE "FileVersion", "2.0.0.0"
            VALUE "InternalName", "InoRobotVirtualControllerBridge"
            VALUE "OriginalFilename", "InoRobotVirtualControllerBridge.exe"
            VALUE "ProductName", "InoRobot Virtual Controller Bridge"
            VALUE "ProductVersion", "2.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END

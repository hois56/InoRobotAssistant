<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GeneratorSourceRoot Condition="'$(GeneratorSourceRoot)' == ''">$(MSBuildThisFileDirectory)..\..\..\InoRobot_Proejct_Gen_for_SDC\InoRobot_Proejct_Gen_for_SDC</GeneratorSourceRoot>
  </PropertyGroup>
  <Target Name="CheckGeneratorSourceRoot" BeforeTargets="PrepareForBuild">
    <Error Condition="!Exists('$(GeneratorSourceRoot)\InoRobot_Project_Gen_for_SDC.csproj')"
           Text="Generator source was not found at '$(GeneratorSourceRoot)'. Set GeneratorSourceRoot to the InoRobot Project Generator source directory." />
  </Target>
  <ItemGroup>
    <Content Include="$(GeneratorSourceRoot)\Templates\SDC\**\*">
      <Link>Templates\SDC\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Compile Include="$(GeneratorSourceRoot)\TemplateProvider.cs" Link="Generator\TemplateProvider.cs" />
    <Compile Include="$(GeneratorSourceRoot)\00_Models\*.cs" LinkBase="Generator\Models" />
    <Compile Include="$(GeneratorSourceRoot)\01_Data\*.cs" LinkBase="Generator\Data" />
    <Compile Include="$(GeneratorSourceRoot)\02_Program\*.cs" LinkBase="Generator\Programs" />
    <Compile Include="$(GeneratorSourceRoot)\03_Generators\*.cs"
             Exclude="$(GeneratorSourceRoot)\03_Generators\ErrorCodeGenerator.cs"
             LinkBase="Generator\Generators" />
  </ItemGroup>
</Project>
